# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API).

# URL do projeto, ex.: https://abcdefgh.supabase.co
SUPABASE_URL=

# Chave "service_role" (secret). Usada SOMENTE no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Nome do bucket do Storage onde as fotos são guardadas
SUPABASE_BUCKET=fotos
